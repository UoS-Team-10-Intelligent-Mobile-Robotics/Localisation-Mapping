    def lidar_callback(self, msg):
        # This is a callback function that is called whenever a message is received        
        # print("Received lidar message", msg.header.seq)
        self.got_new_measuremet = True 
        self.m_range = []  # range and bearing to map elements
        self.m_bearing = []  # Reset the bearing list for each new scan

        self.range_bearing_obs = []
        self.range_bearing_std = []

        self.z_range = np.full(self.lidar.n_beams, np.nan)
        self.z_range_std = np.full(self.lidar.n_beams, np.nan)

        if self.sim_init == True:
            self.sim_time_offset = datetime.now(timezone.utc).timestamp() - msg.header.stamp
            self.sim_init = False     

        msg.header.stamp += self.sim_time_offset


        self.lidar_timestamp_s = msg.header.stamp  # we want the lidar measurement timestamp here

        # b to e frame
        p_eb = Vector(3)

        # # use est to simplify
        p_eb[0,0] = self.measured_pose_northings_m  # robot pose northings (see Task 3)
        p_eb[1,0] = self.measured_pose_eastings_m  # robot pose eastings (see Task 3)
        p_eb[2,0] = self.measured_pose_yaw_rad  # robot pose yaw (see Task 3)

        self.lidar_data = np.zeros((len(msg.ranges), 2))  # specify length

        for i in range(len(msg.ranges)):
            self.z_lm[0,0] = msg.ranges[i]
            self.z_lm[1,0] = msg.angles[i]
            self.m_bearing.append(self.z_lm[1,0])   
            self.m_range.append(self.z_lm[0,0])  # range and bearing to map elements

            self.t_em = self.lidar.rangeangle_to_loc(p_eb, self.z_lm)  #output x and y in the e-frame

            self.lidar_data[i, 0] = self.t_em[0]  
            self.lidar_data[i, 1] = self.t_em[1]

        self.bearing_resolution = np.linspace(-self.lidar.scan_fov / 2, self.lidar.scan_fov / 2, self.lidar.n_beams)
        
        # output z_range & z_range_std
        for idx, theta in enumerate(self.bearing_resolution):        
            if not np.all(np.isnan(self.m_bearing)):
                i = np.nanargmin(abs(theta - np.array(self.m_bearing)))  # Find nearest valid map element
                
                if abs(theta - self.m_bearing[i]) < self.lidar.scan_fov / (2 * self.lidar.n_beams):  # Check threshold
                    self.z_range[idx] = self.m_range[i]
                    self.z_range_std[idx] = abs(self.m_range[i] * self.sigma_observe[0, 0])  

        # this filters out any NaN values
        self.lidar_data = self.lidar_data[~np.isnan(self.lidar_data).any(axis=1)]
        self.observations = np.column_stack((self.z_range, self.bearing_resolution))
        self.observations_std = np.column_stack((self.z_range_std, self.bearing_resolution))
        
        print('Observation updated, Observation std')
        print('Particle filter update')

        kde_pose, kde_std = self.particle_filter.kde_pose(sigma_resolution=0.2, sampling_resolution=100)
        self.est_pose_northings_m = kde_pose[0,0]
        self.est_pose_eastings_m = kde_pose[1,0]
        self.est_pose_yaw_rad = kde_pose[2,0]
        self.est_pose_yaw_rad = self.est_pose_yaw_rad % (2 * np.pi)  # deal with angle wrapping

        valid_indices = ~np.isnan(self.observations).any(axis=1)
        valid_obs_count = np.count_nonzero(valid_indices)

        if valid_obs_count > 0:
            print(f"Updating with {valid_obs_count} valid observations")
            # Filter out invalid observations
            valid_observations = self.observations[valid_indices]
            valid_observations_std = self.observations_std[valid_indices]

            # Only update if we have enough valid observations
            if valid_observations.shape[0] > 2:  # Need at least 2 points for meaningful update
                self.particle_filter.observation_update(
                    valid_observations, 
                    valid_observations_std, 
                    self.map_std, 
                    self.length_scale, 
                    resampling_flag=True, 
                    gpr_sample_cap=self.gpr_sample_cap,
                    show_plot=False
                )
        print('Measured Pose : ', self.measured_pose_northings_m, self.measured_pose_eastings_m, self.measured_pose_yaw_rad)
        print('Estimated Pose : ', self.est_pose_northings_m, self.est_pose_eastings_m, self.est_pose_yaw_rad)
        self.datalog.log(msg, topic_name="/lidar")
        
        if plot:

            self.map_viz.update_particles(self.particle_filter)
            self.map_viz.update_robot_pose(
                self.est_pose_northings_m, 
                self.est_pose_eastings_m, 
                self.est_pose_yaw_rad
            )  

            if hasattr(self, 'observations') and not self.initialise_pose:
                # Create the standard deviation array if not already available
                if not hasattr(self, 'observations_std'):

                    self.observations_std = np.zeros_like(self.observations)
                    self.observations_std[:, 0] = 0.01 * self.observations[:, 0]
                    self.observations_std[:, 1] = np.deg2rad(1)
                    
                # Process the latest scan with GPR
                gpr_results = self.process_lidar_with_gpr(
                    self.observations, 
                    self.observations_std,
                    show_plots=False  # Set to False in production for performance
                )
                
            # Use the GPR results
            if gpr_results is not None:
                # Update visualization with continuous GPR map
                if gpr_results['continuous_map'] is not None:
                    print("GPR continuous map updated")
                    # Transform points to world frame
                    p_eb = Vector(3)
                    p_eb[0,0] = self.est_pose_northings_m
                    p_eb[1,0] = self.est_pose_eastings_m
                    p_eb[2,0] = self.est_pose_yaw_rad % (2 * np.pi)  # Angle wrapping
                    
                    H_eb = HomogeneousTransformation(p_eb[0:2], p_eb[2])
                    
                    # Convert continuous map from robot to world frame
                    continuous_map = gpr_results['continuous_map']
                    world_points = []
                    
                    for point in continuous_map:
                        # Create point in robot frame
                        point_rb = Vector(2)
                        point_rb[0,0] = point[0]
                        point_rb[1,0] = point[1]
                        
                        # Transform to world frame
                        point_world = H_eb.H @ np.vstack([point_rb, [1]])
                        world_points.append([point_world[0, 0], point_world[1, 0], point[2]])
                    
                    # Update visualization - this will add the GPR data to the next saved image
                    if len(world_points) > 0:
                        self.map_viz.update_gpr_continuous_map(np.array(world_points))
            
            point_data = np.column_stack((valid_observations, np.full((len(valid_observations), 1), len(self.accumulated_map_points))))

            # Store the points
            if not hasattr(self, 'accumulated_map_points'):
                self.accumulated_map_points = point_data
            else:
                self.accumulated_map_points = np.vstack((self.accumulated_map_points, point_data))
            
            # Limit the size if needed
            if len(self.accumulated_map_points) > 10000:  # Adjust based on your performance needs
                self.accumulated_map_points = self.accumulated_map_points[-10000:]
                    


