    def pose_parse(self, msg, aruco=False):
        # parser converts pose data to a standard format for logging
        time_stamp = msg[0]

        if aruco == True:
            if self.sim_init == True:
                # Fix: use the timestamp from the tuple instead of msg.header.stamp
                self.sim_time_offset = datetime.now(timezone.utc).timestamp() - time_stamp
                self.sim_init = False

            # self.sim_time_offset is 0 if not a simulation
            time_stamp = time_stamp + self.sim_time_offset


        pose_msg = PoseStamped()
        pose_msg.header = Header()
        pose_msg.header.stamp = time_stamp
        pose_msg.pose.position.x = msg[1]
        pose_msg.pose.position.y = msg[2]
        pose_msg.pose.position.z = 0

        quat = Quaternion()
        if self.simulation == False and aruco == True:
            quat.from_euler(0, 0, np.deg2rad(msg[6]))
        else:
            quat.from_euler(0, 0, msg[6])
        pose_msg.pose.orientation = quat
        return pose_msg

    def generate_trajectory(self):
        # pick waypoints as current pose relative or absolute northings and eastings
        if self.relative_path == True: #may need to wait as it has reached the first point

            for i in range(len(self.northings_path)):
                self.northings_path[i] += self.est_pose_eastings_m #offset by current northings
                self.eastings_path[i] += self.est_pose_northings_m  #offset by current eastings


        # convert path to matrix and create a trajectory class instance
        C = l2m([self.northings_path, self.eastings_path])
        self.path = TrajectoryGenerate(C[:, 0], C[:, 1])

        # set trajectory variables (velocity, acceleration and turning arc radius)
        self.path.path_to_trajectory(self.velocity, self.acceleration) #velocity and acceleration
        self.path.turning_arcs(self.turning_radius)  # turning radius
        self.path.wp_id = 0  # initialises the next waypoint

    def run(self, time_to_run=-1):
        self.start_time = datetime.utcnow().timestamp()

        try:
            r = Rate(10.0)
            while True:
                current_time = datetime.utcnow().timestamp()
                if time_to_run > 0 and current_time - self.start_time > time_to_run:
                    print("Time is up, stopping…")
                    break
                self.infinite_loop()
                r.sleep()
        except KeyboardInterrupt:
            print("KeyboardInterrupt received, stopping…")
        except Exception as e:
            print("Exception: ", e)
        finally:
            self.lidar_sub.stop()
            self.groundtruth_sub.stop()
            self.true_wheel_speed_sub.stop()

    def infinite_loop(self):
        """Main control loop

        Your code should go here.
        """
        # > Sense < #
        # get the latest position measurements
        aruco_pose = self.aruco_driver.read()

        self.got_new_measuremet = False

        if aruco_pose is not None:
            # converts aruco date to zeroros PoseStamped format
            msg = self.pose_parse(aruco_pose, aruco=True)

            # reads sensed pose for local use
            self.measured_pose_timestamp_s = msg.header.stamp
            self.measured_pose_northings_m = msg.pose.position.x
            self.measured_pose_eastings_m = msg.pose.position.y
            _, _, self.measured_pose_yaw_rad = msg.pose.orientation.to_euler()
            self.measured_pose_yaw_rad = self.measured_pose_yaw_rad % (np.pi * 2)  

            self.datalog.log(msg, topic_name="/aruco")

            if self.initialise_pose == True:
                self.est_pose_northings_m = self.measured_pose_northings_m
                self.est_pose_eastings_m = self.measured_pose_eastings_m
                self.est_pose_yaw_rad = self.measured_pose_yaw_rad

                self.t_prev = datetime.now(timezone.utc).timestamp() #initialise the time
                self.t = 0  
                time.sleep(0.1)  

                p = Vector(3) # initial pose
                p[0] = self.measured_pose_northings_m
                p[1] = self.measured_pose_eastings_m
                p[2] = self.measured_pose_yaw_rad

                self.particle_filter = ParticlePathSLAM(self.num_particles,
                                                self.lidar,
                                                p, 
                                                self.position_std,                                 
                                                self.auxilliary_noise)
                self.initialise_pose = False
                self.generate_trajectory()
                self.got_new_measuremet = True

        if self.initialise_pose != True:

            q = Vector(2)
            q[0] = self.measured_wheelrate_right 
            q[1] = self.measured_wheelrate_left  
            
            u = self.ddrive.fwd_kinematics(q)

            t_now = datetime.now(timezone.utc).timestamp()   
            dt = t_now - self.t_prev 
            self.t += dt 
            self.t_prev = t_now  #

            self.particle_filter.predict(u,dt) # motion of particles      
            kde_pose, kde_std = self.particle_filter.kde_pose(sigma_resolution=0.2, sampling_resolution=100)
 
            print('Particle filter predict')     

            # Update robot pose from particle filter estimate
            self.est_pose_northings_m = kde_pose[0,0]
            self.est_pose_eastings_m = kde_pose[1,0]
            self.est_pose_yaw_rad = kde_pose[2,0]
            self.est_pose_yaw_rad = self.est_pose_yaw_rad % (2 * np.pi)  # deal with angle wrapping
            
            if plot:
                self.map_viz.update_lidar_scan(self.lidar_data)
                self.realtime_viz.update_lidar_scan(self.lidar_data)
                
                if hasattr(self, 'accumulated_map_points') and len(self.accumulated_map_points) > 0:
                    self.map_viz.update_persistent_scans(self.accumulated_map_points)
                
                self.map_viz.update_particles(self.particle_filter)
                self.map_viz.update_robot_pose(
                    self.est_pose_northings_m, 
                    self.est_pose_eastings_m, 
                    self.est_pose_yaw_rad
                )
                self.realtime_viz.update_particles(self.particle_filter)
                self.realtime_viz.update_robot_pose(
                    self.est_pose_northings_m, 
                    self.est_pose_eastings_m, 
                    self.est_pose_yaw_rad
                )

            p_robot = Vector(3)
            p_robot[0, 0] = self.est_pose_northings_m
            p_robot[1, 0] = self.est_pose_eastings_m
            p_robot[2, 0] = self.est_pose_yaw_rad

            p_robot,_,_,_ = rigid_body_kinematics(p_robot, u, dt)
            p_robot[2,0] = p_robot[2,0] % (2 * np.pi)  # deal with angle wrapping

            ## issue here

            msg = self.pose_parse(

                [
                    datetime.utcnow().timestamp(),
                    self.est_pose_northings_m,
                    self.est_pose_eastings_m,
                    0,
                    0,
                    0,
                    self.est_pose_yaw_rad,
                ]
            )
            self.datalog.log(msg, topic_name="/est_pose")


            # feedforward control: check wp progress and sample reference trajectory
            self.path.path_to_trajectory(self.velocity, self.acceleration) #velocity and acceleration
            self.path.turning_arcs(self.turning_radius) #turning radius
            self.path.wp_progress(self.t, p_robot, self.acceptance_radius) #probot heading in rad
            p_ref, u_ref = self.path.p_u_sample(self.t)  # output rad 


            # feedback control: get pose change to desired trajectory from body
            dp = p_ref - p_robot  # compute difference between reference and estimated pose in the e-frame
            dp[2] = (dp[2] + np.pi) % (2 * np.pi) - np.pi # handle angle wrapping for yaw
            H_eb = HomogeneousTransformation(p_robot[0:2], p_robot[2])
            ds = Inverse(H_eb.H_R) @ dp    
            # compute control gains for the initial condition (where the robot is stationary)
            
            self.k_s = 1 / self.tau_s  # ks
            # compute control gains for the initial condition (where the robot is stationary)
            if self.initialise_control == True:
                self.k_n = 2 * u_ref[0] / (self.L**2)
                self.k_g = u_ref[0] / self.L
                self.initialise_control = False

            # update the controls
            du = feedback_control(ds, self.k_s, self.k_n, self.k_g)

            # total control
            u = u_ref + du  # combine the feedforward and feedback control twist components

            # ensure within performance limitation
            if u[0] > self.v_max:
                u[0] = self.v_max
            if u[0] < -self.v_max:
                u[0] = -self.v_max
            if u[1] > self.w_max:
                u[1] = self.w_max
            if u[1] < -self.w_max:
                u[1] = -self.w_max

            # update control gains for the next timestep using current velocity, which is stored in u
            self.k_n = 2 * u[0] / (self.L**2)
            self.k_g = u[0] / self.L


            if self.got_new_measuremet == True:
                print('Particle filter update, under loop')

                kde_pose, kde_std = self.particle_filter.kde_pose(sigma_resolution=0.2, sampling_resolution=100)
            #     # Update robot pose from particle filter estimate
                self.est_pose_northings_m = kde_pose[0,0]
                self.est_pose_eastings_m = kde_pose[1,0]
                self.est_pose_yaw_rad = kde_pose[2,0]
                self.est_pose_yaw_rad = self.est_pose_yaw_rad % (2 * np.pi)  # deal with angle wrapping
                
                print('Std: ', kde_std)
                print("Updated PF pose: ", self.est_pose_northings_m, self.est_pose_eastings_m, self.est_pose_yaw_rad)
                print('Measured pose: ', self.measured_pose_northings_m, self.measured_pose_eastings_m, self.measured_pose_yaw_rad)
                
                self.map_viz.update_lidar_scan(self.lidar_data)
                self.realtime_viz.update_lidar_scan(self.lidar_data)

                self.got_new_measuremet = False

            # actuator commands
            q = self.ddrive.inv_kinematics(u)

            wheel_speed_msg = Vector3Stamped()
            wheel_speed_msg.vector.x = q[0, 0]  # Right wheel speed
            wheel_speed_msg.vector.y = q[1, 0]  # Left wheel speed

            self.cmd_wheelrate_right = wheel_speed_msg.vector.x
            self.cmd_wheelrate_left = wheel_speed_msg.vector.y
            ################################################################################

            # > Act < #
            # Send commands to the robot
            self.wheel_speed_pub.publish(wheel_speed_msg)
            self.datalog.log(wheel_speed_msg, topic_name="/wheel_speeds_cmd")


