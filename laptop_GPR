    def process_lidar_with_gpr(self, new_scan_rb, new_scan_std=None, 
                             show_plots=False, previous_scans=None):
        """Process current LiDAR scan with GPR to analyze environment structure and uncertainty.
        
        Args:
            new_scan_rb: Current LiDAR scan in (range, bearing) format
            new_scan_std: Standard deviation of measurements (optional)
            show_plots: Whether to visualize the GPR results
            previous_scans: List of previous scans to train the GPR model (optional)
        
        Returns:
            dict: Results including GPR predictions, uncertainty, and structured environment info
        """
        # If no previous scans provided, use the last few processed scans
        if previous_scans is None and hasattr(self, 'recent_lidar_scans'):
            previous_scans = self.recent_lidar_scans
        
        # If we don't have enough previous data, store current scan and return
        if previous_scans is None or len(previous_scans) < 1:
            if not hasattr(self, 'recent_lidar_scans'):
                self.recent_lidar_scans = []
            
            # Store at most 100 recent scans
            self.recent_lidar_scans.append(new_scan_rb)
            if len(self.recent_lidar_scans) > 100:
                self.recent_lidar_scans.pop(0)
            
            return None
        
        # Combine past observations into a single array
        past_data = np.vstack(previous_scans)
        
        # Process with GPR
        weight, range_pred, std_pred = update_lidar_observations_with_gpr(
            past_data, 
            new_scan_rb,
            new_scan_std,
            sensor_range=self.lidar.distance_range,
            sensor_fov=self.lidar.scan_fov,
            map_std=self.map_std,
            rbf_length_scale=self.length_scale,
            gpr_sample_cap=self.gpr_sample_cap,
            show_plots=False
        )
        
        # Store current scan
        if not hasattr(self, 'recent_lidar_scans'):
            self.recent_lidar_scans = []
        
        self.recent_lidar_scans.append(new_scan_rb)
        if len(self.recent_lidar_scans) > 10:
            self.recent_lidar_scans.pop(0)
        
        # Analyze environment structure based on GPR predictions
        # You can add more advanced analysis here
        results = {
            'likelihood': weight,
            'predictions': range_pred,
            'uncertainty': std_pred,
            'continuous_map': self._create_continuous_map(new_scan_rb, range_pred, std_pred)
        }
        
        return results

    def _create_continuous_map(self, scan_rb, predictions, uncertainties):
        """Convert GPR predictions to a continuous map representation.
        
        Returns:
            np.ndarray: Array of (x, y, uncertainty) points in the robot frame
        """
        if predictions is None or uncertainties is None:
            return None
            
        # Convert polar (range, bearing) to Cartesian (x, y)
        points = []
        for i in range(len(predictions)):
            r = predictions[i][0]
            theta = scan_rb[i][1]
            x = r * np.cos(theta)
            y = r * np.sin(theta)
            uncertainty = uncertainties[i][0]
            points.append([x, y, uncertainty])
        
        return np.array(points)

